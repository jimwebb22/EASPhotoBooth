<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Identity -->
    <key>CFBundleDisplayName</key>
    <string>EtchBot</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>EtchBot</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <!-- Deployment -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
<key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>

    <!-- Orientation -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Privacy — REQUIRED for App Store Review -->
    <key>NSCameraUsageDescription</key>
    <string>EtchBot uses the camera to capture photos for Etch-a-Sketch drawings.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>EtchBot accesses your photo library to select images for Etch-a-Sketch drawings.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>EtchBot saves drawing previews to your photo library.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>EtchBot uses Bluetooth to communicate with your Etch-a-Sketch drawing device.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>EtchBot uses Bluetooth to communicate with your Etch-a-Sketch drawing device.</string>

    <!-- Background Modes — needed for BLE transfer completion when app is backgrounded -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>

    <!-- App Transport Security — no external network requests -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Scene Configuration (SwiftUI lifecycle) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Launch Screen -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
</dict>
</plist>
